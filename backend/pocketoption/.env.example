# Copy to .env and fill in. NEVER commit .env or real values.

# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telethon StringSession for the Telegram user account that can message AffiliatePocketBot
TELEGRAM_SESSION_STRING=

# Block login when Telegram verification is unavailable or not configured
REQUIRE_VERIFICATION=true

# Optional: exactly one Trader ID may bypass Telegram verification.
# BYPASS_TRADER_ID=

# Session tokens (issued at login, required by /signal and /correlations).
# Use a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# Protects admin endpoints (/config/data-source, /update-cache, /candle-data, /refresh-po-session)
ADMIN_KEY=

# Pocket Option session (WebSocket 42["auth",...] token)
# LO_UID=

# Claude reviews the shortlisted signals (optional; without a key the plain indicator ranking is used)
ANTHROPIC_API_KEY=
# CLAUDE_JUDGE_MODEL=claude-opus-5-5
