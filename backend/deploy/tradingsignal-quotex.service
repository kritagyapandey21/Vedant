[Unit]
Description=TradingSignal Quotex backend
After=network.target

[Service]
Type=simple
User=tsignal
Group=tsignal
WorkingDirectory=/opt/tradingsignal/backend/quotex
EnvironmentFile=/opt/tradingsignal/backend/quotex/.env
Environment=TRADER_DB_PATH=/var/lib/tradingsignal/qx_trader_preferences.sqlite3
Environment=ALLOWED_ORIGINS=https://__DOMAIN__
# Cloudflare blocks Python clients on a server: open the Quotex socket from a real Chrome (api_quotex/browser_ws.py)
Environment=QUOTEX_TRANSPORT=browser
Environment=QUOTEX_BROWSER_DIR=/opt/tradingsignal/browsers/cft
# xvfb-run gives Chrome a virtual screen (the server has none); installed by deploy/install_quotex_browser.sh
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1280x800x24 -nolisten tcp" /opt/tradingsignal/venv/bin/uvicorn app:app --host 127.0.0.1 --port __QX_PORT__ --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=10

# stay inside our own folders and keep a lid on resources so the other sites on this VPS are not affected
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tradingsignal/backend/quotex /opt/tradingsignal/backend/quotex_lib /var/lib/tradingsignal
MemoryMax=1300M
CPUQuota=60%
# Chrome uses many threads
TasksMax=2000

[Install]
WantedBy=multi-user.target
