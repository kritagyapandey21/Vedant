# Quotex account used for market DATA only (the app never places trades).
QX_EMAIL=you@example.com
QX_PASSWORD=change_me
QX_IS_DEMO=true
# Pairs paying at least this % and of these Quotex asset types are scanned
QX_MIN_PAYOUT=80
QX_ASSET_TYPES=currency

# Comma separated IDs allowed to log in. Empty = any ID accepted (local use only).
ACCESS_IDS=
# Protects /refresh-session. Empty = open (local use only).
ADMIN_KEY=

# Session tokens (issued at login, required by /signal and /correlations).
# Use a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# Optional: reuse an existing api_quotex sessions/ folder (e.g. the backend/quotex_lib checkout)
# QX_DATA_DIR=../quotex_lib

# Claude reviews the shortlisted signals (optional; without a key the plain indicator ranking is used)
ANTHROPIC_API_KEY=
# CLAUDE_JUDGE_MODEL=claude-opus-5-5

# Trader ID check through the Quotex partner bot on Telegram (same idea as the Pocket Option terminal).
# REQUIRE_VERIFICATION=false lets every ID in. true = the ID must be known to the bot.
# Make the session string with make_telegram_session.py, and use a SEPARATE one from the Pocket Option backend
# (two processes sharing one Telegram session kick each other out).
REQUIRE_VERIFICATION=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# QUOTEX_BOT_USERNAME=quotexpartnerbot
# QUOTEX_MIN_DEPOSIT=0
# An ID that always gets in, whatever the bot says (yours, for testing)
BYPASS_TRADER_ID=
